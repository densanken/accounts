{
  "name": "accounts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:worker": "wrangler deploy --dry-run",
    "start": "wrangler dev",
    "lint": "biome check --write --error-on-warnings --diagnostic-level=warn && tsc --noEmit",
    "lint:check": "biome ci --error-on-warnings --diagnostic-level=warn && tsc --noEmit",
    "lint:unsafe": "biome check --write --unsafe --error-on-warnings --diagnostic-level=warn && tsc --noEmit",
    "fmt": "biome format --write",
    "fmt:check": "biome format",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "postinstall": "wrangler types"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6",
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "isbot": "^5.2.2",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "^1.57.2",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.2"
  }
}
