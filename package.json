{
  "name": "accounts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:worker": "wrangler deploy --dry-run",
    "start": "wrangler dev",
    "typegen": "react-router typegen",
    "lint": "biome check --write --error-on-warnings --diagnostic-level=warn && tsc --noEmit",
    "lint:check": "biome ci --error-on-warnings --diagnostic-level=warn && tsc --noEmit",
    "lint:unsafe": "biome check --write --unsafe --error-on-warnings --diagnostic-level=warn && tsc --noEmit",
    "fmt": "biome format --write",
    "fmt:check": "biome format",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "postinstall": "wrangler types && react-router typegen"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "isbot": "^5.2.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "^1.57.2",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.0",
    "vite": "^8.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.136.2"
  }
}
